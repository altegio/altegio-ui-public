import { type TPropTestCase } from '~shared/types/tests'
import { type IAltNgInputFieldProps } from '~ng/ui/inputField/models/types'
import { EAltSizes } from '~shared/types/global'
import { text, empty, number } from '~shared/tests/slotContents'
import { createCoreInputFieldProps } from '~core/ui/inputField/models/types'
import { EAltCoreInputTypeProp } from '~core/ui/inputField/models/types'
import { testMaskOptions } from '~core/ui/inputField/tests/cases/props'

const { required, size, disabled, maxlength, autofocus, type, clearable, labelText, labelTooltipText, annotationText, labelOverflowDebounce, maskOptions, errors, name, placeholder, readonly } = createCoreInputFieldProps()

export const propValueCases: TPropTestCase<IAltNgInputFieldProps, 'value'>[] = [
  { prop: 'value', case: 'with text', value: text, expected: text },
  { prop: 'value', case: 'without text', value: '', expected: '' },
]
export const propNameTestCases: TPropTestCase<IAltNgInputFieldProps, 'name'>[] = [
  { prop: 'name', case: 'with text', value: text, expected: text },
  { prop: 'name', case: 'without text', value: '', expected: '' },
  { prop: 'name', case: 'undefined', value: undefined, expected: name },
]
export const propPlaceholderTestCases: TPropTestCase<IAltNgInputFieldProps, 'placeholder'>[] = [
  { prop: 'placeholder', case: 'with text', value: text, expected: text },
  { prop: 'placeholder', case: 'without text', value: '', expected: '' },
  { prop: 'placeholder', case: 'undefined', value: undefined, expected: placeholder },
]
export const propAutofocusTestCases: TPropTestCase<IAltNgInputFieldProps, 'autofocus'>[] = [
  { prop: 'autofocus', case: 'true', value: true, expected: true },
  { prop: 'autofocus', case: 'false', value: false, expected: false },
  { prop: 'autofocus', case: 'undefined', value: undefined, expected: autofocus },
]
export const propTypeTestCases: TPropTestCase<IAltNgInputFieldProps, 'type'>[] = [
  { prop: 'type', case: 'text', value: EAltCoreInputTypeProp.TEXT, expected: EAltCoreInputTypeProp.TEXT },
  { prop: 'type', case: 'number', value: EAltCoreInputTypeProp.NUMBER, expected: EAltCoreInputTypeProp.NUMBER },
  { prop: 'type', case: 'undefined', value: undefined, expected: type },
]
export const propDisabledTestCases: TPropTestCase<IAltNgInputFieldProps, 'disabled'>[] = [
  { prop: 'disabled', case: 'true', value: true, expected: true },
  { prop: 'disabled', case: 'false', value: false, expected: false },
  { prop: 'disabled', case: 'undefined', value: undefined, expected: disabled },
]
export const propReadonlyTestCases: TPropTestCase<IAltNgInputFieldProps, 'readonly'>[] = [
  // { prop: 'readonly', case: 'true', value: true, expected: true }, // TODO: fix readonly
  { prop: 'readonly', case: 'false', value: false, expected: false },
  { prop: 'readonly', case: 'undefined', value: undefined, expected: readonly },
]
export const propRequiredTestCases: TPropTestCase<IAltNgInputFieldProps, 'required'>[] = [
  { prop: 'required', case: 'true', value: true, expected: true },
  { prop: 'required', case: 'false', value: false, expected: false },
  { prop: 'required', case: 'undefined', value: undefined, expected: required },
]
export const propMaxlengthTestCases: TPropTestCase<IAltNgInputFieldProps, 'maxlength'>[] = [
  { prop: 'maxlength', case: '10', value: 10, expected: 10 },
  { prop: 'maxlength', case: '0', value: 0, expected: 0 },
  { prop: 'maxlength', case: 'undefined', value: undefined, expected: maxlength },
]
export const propMaskOptionsTestCases: TPropTestCase<IAltNgInputFieldProps, 'maskOptions'>[] = [
  { prop: 'maskOptions', case: 'with a mask', value: testMaskOptions, expected: testMaskOptions },
  { prop: 'maskOptions', case: 'undefined', value: undefined, expected: maskOptions },
]
export const propErrorsTestCases: TPropTestCase<IAltNgInputFieldProps, 'errors'>[] = [
  { prop: 'errors', case: 'array with errors', value: ['error'], expected: ['error'] },
  { prop: 'errors', case: 'empty array', value: [], expected: [] },
  { prop: 'errors', case: 'undefined', value: undefined, expected: errors },
]
export const propClearableTestCases: TPropTestCase<IAltNgInputFieldProps, 'clearable'>[] = [
