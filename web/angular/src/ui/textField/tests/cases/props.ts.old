export const propSizeTestCases: TPropTestCase<IAltNgInputFieldProps, 'size'>[] = [
  { prop: 'size', case: EAltSizes.SMALL, value: EAltSizes.SMALL, expected: EAltSizes.SMALL },
  { prop: 'size', case: EAltSizes.MEDIUM, value: EAltSizes.MEDIUM, expected: EAltSizes.MEDIUM },
  { prop: 'size', case: 'undefined', value: undefined, expected: size },
]
export const propLabelOverflowDebounceTestCases: TPropTestCase<IAltNgInputFieldProps, 'labelOverflowDebounce'>[] = [
  { prop: 'labelOverflowDebounce', case: 'number', value: Number(number), expected: number },
  { prop: 'labelOverflowDebounce', case: 'undefined', value: undefined, expected: labelOverflowDebounce },
