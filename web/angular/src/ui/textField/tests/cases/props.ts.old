import { type TPropTestCase } from '~shared/types/tests'
import { type IYNgInputFieldProps } from '~ng/ui/inputField/models/types'
import { EYSizes } from '~shared/types/global'
import { text, empty, number } from '~shared/tests/slotContents'
import { createCoreInputFieldProps } from '~core/ui/inputField/models/types'
import { EYCoreInputTypeProp } from '~core/ui/inputField/models/types'
import { testMaskOptions } from '~core/ui/inputField/tests/cases/props'

const { required, size, disabled, maxlength, autofocus, type, clearable, labelText, labelTooltipText, annotationText, labelOverflowDebounce, maskOptions, errors, name, placeholder, readonly } = createCoreInputFieldProps()

export const propValueCases: TPropTestCase<IYNgInputFieldProps, 'value'>[] = [
  { prop: 'value', case: 'с текстом', value: text, expected: text },
  { prop: 'value', case: 'без текста', value: '', expected: '' },
]
export const propNameTestCases: TPropTestCase<IYNgInputFieldProps, 'name'>[] = [
  { prop: 'name', case: 'с текстом', value: text, expected: text },
  { prop: 'name', case: 'без текста', value: '', expected: '' },
  { prop: 'name', case: 'undefined', value: undefined, expected: name },
]
export const propPlaceholderTestCases: TPropTestCase<IYNgInputFieldProps, 'placeholder'>[] = [
  { prop: 'placeholder', case: 'с текстом', value: text, expected: text },
  { prop: 'placeholder', case: 'без текста', value: '', expected: '' },
  { prop: 'placeholder', case: 'undefined', value: undefined, expected: placeholder },
]
export const propAutofocusTestCases: TPropTestCase<IYNgInputFieldProps, 'autofocus'>[] = [
  { prop: 'autofocus', case: 'true', value: true, expected: true },
  { prop: 'autofocus', case: 'false', value: false, expected: false },
  { prop: 'autofocus', case: 'undefined', value: undefined, expected: autofocus },
]
export const propTypeTestCases: TPropTestCase<IYNgInputFieldProps, 'type'>[] = [
  { prop: 'type', case: 'text', value: EYCoreInputTypeProp.TEXT, expected: EYCoreInputTypeProp.TEXT },
  { prop: 'type', case: 'number', value: EYCoreInputTypeProp.NUMBER, expected: EYCoreInputTypeProp.NUMBER },
  { prop: 'type', case: 'undefined', value: undefined, expected: type },
]
export const propDisabledTestCases: TPropTestCase<IYNgInputFieldProps, 'disabled'>[] = [
  { prop: 'disabled', case: 'true', value: true, expected: true },
  { prop: 'disabled', case: 'false', value: false, expected: false },
  { prop: 'disabled', case: 'undefined', value: undefined, expected: disabled },
]
export const propReadonlyTestCases: TPropTestCase<IYNgInputFieldProps, 'readonly'>[] = [
  // { prop: 'readonly', case: 'true', value: true, expected: true }, // TODO: fix readonly
  { prop: 'readonly', case: 'false', value: false, expected: false },
  { prop: 'readonly', case: 'undefined', value: undefined, expected: readonly },
]
export const propRequiredTestCases: TPropTestCase<IYNgInputFieldProps, 'required'>[] = [
  { prop: 'required', case: 'true', value: true, expected: true },
  { prop: 'required', case: 'false', value: false, expected: false },
  { prop: 'required', case: 'undefined', value: undefined, expected: required },
]
export const propMaxlengthTestCases: TPropTestCase<IYNgInputFieldProps, 'maxlength'>[] = [
  { prop: 'maxlength', case: '10', value: 10, expected: 10 },
  { prop: 'maxlength', case: '0', value: 0, expected: 0 },
  { prop: 'maxlength', case: 'undefined', value: undefined, expected: maxlength },
]
export const propMaskOptionsTestCases: TPropTestCase<IYNgInputFieldProps, 'maskOptions'>[] = [
  { prop: 'maskOptions', case: 'с маской', value: testMaskOptions, expected: testMaskOptions },
  { prop: 'maskOptions', case: 'undefined', value: undefined, expected: maskOptions },
]
export const propErrorsTestCases: TPropTestCase<IYNgInputFieldProps, 'errors'>[] = [
  { prop: 'errors', case: 'массив с ошибками', value: ['error'], expected: ['error'] },
  { prop: 'errors', case: 'пустой массив', value: [], expected: [] },
  { prop: 'errors', case: 'undefined', value: undefined, expected: errors },
]
export const propClearableTestCases: TPropTestCase<IYNgInputFieldProps, 'clearable'>[] = [
  { prop: 'clearable', case: 'true', value: true, expected: true },
  { prop: 'clearable', case: 'false', value: false, expected: false },
  { prop: 'clearable', case: 'undefined', value: undefined, expected: clearable },
