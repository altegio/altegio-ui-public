export const propSizeTestCases: TPropTestCase<IYNgInputFieldProps, 'size'>[] = [
  { prop: 'size', case: EYSizes.SMALL, value: EYSizes.SMALL, expected: EYSizes.SMALL },
  { prop: 'size', case: EYSizes.MEDIUM, value: EYSizes.MEDIUM, expected: EYSizes.MEDIUM },
  { prop: 'size', case: 'undefined', value: undefined, expected: size },
]
export const propLabelOverflowDebounceTestCases: TPropTestCase<IYNgInputFieldProps, 'labelOverflowDebounce'>[] = [
  { prop: 'labelOverflowDebounce', case: 'число', value: Number(number), expected: number },
  { prop: 'labelOverflowDebounce', case: 'undefined', value: undefined, expected: labelOverflowDebounce },
]
export const propLabelTextTestCases: TPropTestCase<IYNgInputFieldProps, 'labelText'>[] = [
  { prop: 'labelText', case: 'текст', value: text, expected: text },
  { prop: 'labelText', case: 'пустая строка', value: empty, expected: empty },
