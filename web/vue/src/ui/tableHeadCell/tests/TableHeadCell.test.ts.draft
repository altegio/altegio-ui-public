import { describe, expect, it } from 'vitest'
import { mount } from '@vue/test-utils'

import { AltCoreTableHeadCellTagName } from '~shared/constants'
import type { TPropTestCase, TSlotTestCase } from '~shared/types/tests'
import { text, empty } from '~shared/tests/slotContents'

import AltTableHeadCell from '~vue/ui/tableHeadCell/TableHeadCell.vue'
import {
  createVueTableHeadCellProps,
  type IAltVueTableHeadCellProps,
} from '~vue/ui/tableHeadCell/models/types'
import { AltCoreTableHeadCell } from '~core/ui/tableHeadCell'

const tagName = AltCoreTableHeadCellTagName

const { externalProp: defaultExternalProp, internalProp: defaultInternalProp } = createVueTableHeadCellProps()

// Unit test cases:
const slotDefaultTestCases: TSlotTestCase[] = [
  { slot: 'default', case: 'with content', content: text },
  { slot: 'default', case: 'without content', content: empty },
]
const propExternalPropTestCases: TPropTestCase<IAltVueTableHeadCellProps, 'externalProp'>[] = [
  { prop: 'externalProp', case: 'with content', value: text },
  { prop: 'externalProp', case: 'without content', value: empty },
  { prop: 'externalProp', case: 'without a value', value: defaultExternalProp },
]
const propInternalPropTestCases: TPropTestCase<IAltVueTableHeadCellProps, 'internalProp'>[] = [
  { prop: 'internalProp', case: 'with content', value: text },
  { prop: 'internalProp', case: 'without content', value: empty },
  { prop: 'internalProp', case: 'without a value', value: defaultInternalProp },
]

describe(
  'Vue/AltTableHeadCell',
  () => {
    beforeAll(() => {
      if (!customElements.get(tagName)) {
        customElements.define(
          tagName,
          AltCoreTableHeadCell,
        )
      }
    })

    describe(
      'Unit',
      () => {
        describe(
          'Slots',
          () => {
            for (const testCase of slotDefaultTestCases) {
              it(
                `Slot "${testCase.slot}" should render ${testCase.case}`,
                () => {
                  const wrapper = mount(
                    AltTableHeadCell,
                    { slots: { default: testCase.content } },
                  )

                  expect(wrapper.text()).toBe(testCase.content)
                },
              )
            }
          },
        )

        describe(
          'Props',
          () => {
            for (const testCase of [
              ...propExternalPropTestCases,
              ...propInternalPropTestCases,
            ]) {
              it(
                `Prop "${testCase.prop}" should set ${testCase.prop} on the core component`,
                () => {
                  const wrapper = mount(
                    AltTableHeadCell,
                    { props: { [testCase.prop]: testCase.value } },
                  )

                  const coreElement = wrapper.find(tagName).element as AltCoreTableHeadCell

                  expect(coreElement[testCase.prop]).toBe(testCase.expected)
                },
              )
            }
          },
        )
      },
    )
  },
)
