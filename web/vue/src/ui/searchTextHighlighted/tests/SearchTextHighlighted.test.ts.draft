import { describe, expect, it } from 'vitest'
import { mount } from '@vue/test-utils'

import { YCoreSearchTextHighlightedTagName } from '~shared/constants'
import type { TPropTestCase, TSlotTestCase } from '~shared/types/tests'
import { text, empty } from '~shared/tests/slotContents'

import YSearchTextHighlighted from '~vue/ui/searchTextHighlighted/SearchTextHighlighted.vue'
import {
  createVueSearchTextHighlightedProps,
  type IYVueSearchTextHighlightedProps,
} from '~vue/ui/searchTextHighlighted/models/types'
import { YCoreSearchTextHighlighted } from '~core/ui/searchTextHighlighted'

const tagName = YCoreSearchTextHighlightedTagName

const { externalProp: defaultExternalProp, internalProp: defaultInternalProp } = createVueSearchTextHighlightedProps()

// Unit test cases:
const slotDefaultTestCases: TSlotTestCase[] = [
  { slot: 'default', case: 'с контентом', content: text },
  { slot: 'default', case: 'без контента', content: empty },
]
const propExternalPropTestCases: TPropTestCase<IYVueSearchTextHighlightedProps, 'externalProp'>[] = [
  { prop: 'externalProp', case: 'с контентом', value: text },
  { prop: 'externalProp', case: 'без контента', value: empty },
  { prop: 'externalProp', case: 'без значения', value: defaultExternalProp },
]
const propInternalPropTestCases: TPropTestCase<IYVueSearchTextHighlightedProps, 'internalProp'>[] = [
  { prop: 'internalProp', case: 'с контентом', value: text },
  { prop: 'internalProp', case: 'без контента', value: empty },
  { prop: 'internalProp', case: 'без значения', value: defaultInternalProp },
]

describe(
  'Vue/YSearchTextHighlighted',
  () => {
    beforeAll(() => {
      if (!customElements.get(tagName)) {
        customElements.define(
          tagName,
          YCoreSearchTextHighlighted,
        )
      }
    })

    describe(
      'Unit',
      () => {
        describe(
          'Slots',
          () => {
            for (const testCase of slotDefaultTestCases) {
              it(
                `Slot "${testCase.slot}" должен быть ${testCase.case}`,
                () => {
                  const wrapper = mount(
                    YSearchTextHighlighted,
                    { slots: { default: testCase.content } },
                  )

                  expect(wrapper.text()).toBe(testCase.content)
                },
              )
            }
          },
        )

        describe(
          'Props',
          () => {
            for (const testCase of [
              ...propExternalPropTestCases,
              ...propInternalPropTestCases,
            ]) {
              it(
                `Prop "${testCase.prop}" должен изменить свойство ${testCase.prop} у core компонента`,
                () => {
                  const wrapper = mount(
                    YSearchTextHighlighted,
                    { props: { [testCase.prop]: testCase.value } },
                  )

                  const coreElement = wrapper.find(tagName).element as YCoreSearchTextHighlighted

                  expect(coreElement[testCase.prop]).toBe(testCase.expected)
                },
              )
            }
          },
        )
      },
    )
  },
)
