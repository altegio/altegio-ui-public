import { beforeAll, afterEach, afterAll, describe, expect, it, vi } from 'vitest'

import { AltCoreInputFieldTagName, AltCoreInputTagName, AltCoreLabelTagName, AltCoreAnnotationTagName, AltCoreErrorTagName } from '~shared/constants'
import { text, textWithTag } from '~shared/tests/slotContents'
import { useCoreTests } from '~shared/tests/core'
import { getWCShadowRoot } from '~shared/tests/utils'
import {
  createCoreInputProps,
  type IAltCoreInputInputEvent,
} from '~core/ui/inputField/models/types'
import '~core/ui/inputField'

import { slotCases } from './cases/slots'
import { propSizeCases, propValueCases, propNameCases, propPlaceholderCases, propAutofocusCases, propTypeCases, propDisabledCases, propRequiredCases, propMaxlengthCases, propMaskOptionsCases, propErrorsCases, propClearableCases, propLabelOverflowDebounceCases, propLabelTextCases, propLabelTooltipTextCases, propAnnotationTextCases, propReadonlyCases } from './cases/props'
import { eventsCases } from './cases/events'

const tagName = AltCoreInputFieldTagName

const {
  component,
  updateComponent,
  resetComponent,
  injectComponentToBody,
  removeComponent,
} = useCoreTests(
  tagName,
  createCoreInputProps(),
)

type TSubComponent = typeof AltCoreInputTagName | typeof AltCoreLabelTagName | typeof AltCoreAnnotationTagName | typeof AltCoreErrorTagName
const getSubWC = <T extends TSubComponent>(primaryWC: HTMLElement, secondaryWC: T) => {
  const subWC = getWCShadowRoot(primaryWC).querySelector(secondaryWC)
  if (!subWC) throw new Error(`${secondaryWC} not found`)
  return subWC
}

const getSlotContentSubWC = (WC: HTMLElement, slotName: string) => {
  const slotElement = getWCShadowRoot(WC).querySelector(`slot[name="${slotName}"]`)
  if (!slotElement) throw new Error(`Slot ${slotName} not found`)

  const subWCSlotElement = (slotElement as HTMLSlotElement).assignedNodes()[0] as HTMLSlotElement
  const subWCSlotNodes = subWCSlotElement.assignedNodes()[0] as HTMLSlotElement
  const subWCSlotContent = subWCSlotNodes.innerHTML

  return subWCSlotContent
}

describe(
  'Core/AltCoreInputField/Unit',
  () => {
    beforeAll(() => {
      injectComponentToBody()
    })

    afterEach(async() => {
      await resetComponent()
    })

    afterAll(() => {
      removeComponent()
    })

    describe(
      'Slots',
      () => {
        for (const { slotName, wc } of slotCases) {
          it(
            `Should render the "${slotName}" slot in ${wc}`,
            async() => {
              await updateComponent({ slots: { [slotName]: textWithTag } })

              const subWC = getSubWC(
                component,
                wc,
              )

              const slotContent = getSlotContentSubWC(
                subWC,
                slotName,
              )

              expect(slotContent).toBe(textWithTag)
            },
          )
        }
      },
    )

    describe(
      'Props',
      () => {
        for (const { prop, case: propCase, value } of [
          ...propValueCases,
          ...propNameCases,
          ...propPlaceholderCases,
          ...propAutofocusCases,
          ...propTypeCases,
          ...propReadonlyCases,
          ...propMaxlengthCases,
          ...propMaskOptionsCases,
          ...propClearableCases,
          ...propSizeCases,
        ]) {
          it(
            `Prop "${prop}" should be "${propCase}" and passed to input`,
            async() => {
              await updateComponent({ props: { [prop]: value } })

              const inputElement = getSubWC(
                component,
                AltCoreInputTagName,
              )

              expect(inputElement[prop]).toBe(value)
            },
          )
        }

        for (const { prop, case: propCase, value } of propDisabledCases) {
          it(
            `Prop "${prop}" should be "${propCase}" and passed to input, label and annotation`,
            async() => {
              await updateComponent({ props: { [prop]: value, labelText: text } })

              const inputElement = getSubWC(
                component,
                AltCoreInputTagName,
              )
              const labelElement = getSubWC(
                component,
                AltCoreLabelTagName,
              )
              const annotationElement = getSubWC(
                component,
                AltCoreAnnotationTagName,
              )

              expect(inputElement.disabled).toBe(value)
              expect(labelElement.disabled).toBe(value)
              expect(annotationElement.disabled).toBe(value)
            },
          )
        }

        for (const { prop, case: propCase, value } of propRequiredCases) {
          it(
            `Prop "${prop}" should be "${propCase}" and passed to input and label`,
            async() => {
              await updateComponent({ props: { [prop]: value } })

              const inputElement = getSubWC(
                component,
                AltCoreInputTagName,
              )
              const labelElement = getSubWC(
                component,
                AltCoreLabelTagName,
              )

              expect(inputElement.required).toBe(value)
              expect(labelElement.required).toBe(value)
            },
          )
        }

        for (const { prop, case: propCase, value } of propErrorsCases) {
          it(
            `Prop "${prop}" should be "${propCase}" and passed to input and error`,
            async() => {
              await updateComponent({ props: { [prop]: value } })

              const inputElement = getSubWC(
                component,
                AltCoreInputTagName,
              )

              expect(inputElement.error).toBe(Boolean(value?.length))

              if (value?.length) {
                const errorElement = getSubWC(
                  component,
                  AltCoreErrorTagName,
                )
                expect(errorElement.errors).toBe(value)
              } else {
                expect(() => getSubWC(
                  component,
                  AltCoreErrorTagName,
                )).toThrow(`${AltCoreErrorTagName} not found`)
              }
            },
          )
        }

        for (const { prop, case: propCase, value, labelProp } of propLabelTextCases) {
          it(
            `Prop "${prop}" should be "${propCase}" and passed to label`,
            async() => {
              await updateComponent({ props: { [prop]: value } })

              if (value) {
                const labelElement = getSubWC(
                  component,
                  AltCoreLabelTagName,
                )
                expect(labelElement[labelProp]).toBe(value)
              } else {
                expect(() => getSubWC(
                  component,
                  AltCoreLabelTagName,
                )).toThrow(`${AltCoreLabelTagName} not found`)
              }
            },
          )
        }

        for (const { prop, case: propCase, value, labelProp } of [
          ...propLabelOverflowDebounceCases,
          ...propLabelTooltipTextCases,
        ]) {
          it(
            `Prop "${prop}" should be "${propCase}" and passed to label`,
            async() => {
              await updateComponent({
                props: {
                  [prop]: value,
                  labelText: text,
                },
              })

              const labelElement = getSubWC(
                component,
                AltCoreLabelTagName,
              )

              expect(labelElement[labelProp]).toBe(value)
            },
          )
        }

        for (const { prop, case: propCase, value, annotationProp } of propAnnotationTextCases) {
          it(
            `Prop "${prop}" should be "${propCase}" and passed to annotation`,
            async() => {
              await updateComponent({ props: { [prop]: value } })

              const annotationElement = getSubWC(
                component,
                AltCoreAnnotationTagName,
              )

              expect(annotationElement[annotationProp]).toBe(value)
            },
          )
        }
      },
    )

    describe(
      'Events',
      () => {
        for (const { eventName, payload, event, case: eventCase } of eventsCases) {
          it(
            `Should emit "${eventName}" ${eventCase}`,
            () => {
              const inputElement = getSubWC(
                component,
                AltCoreInputTagName,
              )

              const handler = vi.fn()
              component.addEventListener(
                eventName,
                handler,
              )

              inputElement.dispatchEvent(event)

              expect(handler).toHaveBeenCalledTimes(1)
              expect(JSON.stringify((handler.mock.calls[0][0] as CustomEvent<IAltCoreInputInputEvent>).detail)).toBe(JSON.stringify(payload))
            },
          )

          it(
            `Should not emit "${eventName}" ${eventCase} when the component is disabled`,
            async() => {
              await updateComponent({ props: { disabled: true } })

              const inputElement = getSubWC(
                component,
                AltCoreInputTagName,
              )

              const handler = vi.fn()
              component.addEventListener(
                eventName,
                handler,
              )

              inputElement.dispatchEvent(event)

              expect(handler).not.toHaveBeenCalled()
            },
          )
        }
      },
    )
  },
)
