import { text } from '~shared/tests/slotContents'
import { EAltSizes } from '~shared/types/global'
import type { TPropTestCase } from '~shared/types/tests'
import { type IAltCoreInputFieldProps, EAltCoreInputTypeProp } from '../../models/types'
import { type IAltCoreLabelExternalProps } from '~core/ui/label/models/types'
import { type IAltCoreAnnotationExternalProps } from '~core/ui/annotation/models/types'
import { type MaskitoOptions } from '@maskito/core'

export const testMaskOptions: MaskitoOptions = { mask: /^\d+$/ }
export const testErrors = [
  text,
  text,
]

export const sizes = Object.values(EAltSizes).filter((size) => size !== EAltSizes.EXTRA_LARGE && size !== EAltSizes.EXTRA_SMALL)

export const propValueCases: TPropTestCase<IAltCoreInputFieldProps, 'value'>[] = [
  { prop: 'value', case: 'with text', value: text },
  { prop: 'value', case: 'without text', value: '' },
]
export const propNameCases: TPropTestCase<IAltCoreInputFieldProps, 'name'>[] = [
  { prop: 'name', case: 'with text', value: text },
  { prop: 'name', case: 'without text', value: '' },
]
export const propPlaceholderCases: TPropTestCase<IAltCoreInputFieldProps, 'placeholder'>[] = [
  { prop: 'placeholder', case: 'with text', value: text },
  { prop: 'placeholder', case: 'without text', value: '' },
]
export const propAutofocusCases: TPropTestCase<IAltCoreInputFieldProps, 'autofocus'>[] = [
  { prop: 'autofocus', case: 'true', value: true },
  { prop: 'autofocus', case: 'false', value: false },
]
export const propTypeCases: TPropTestCase<IAltCoreInputFieldProps, 'type'>[] = Object.values(EAltCoreInputTypeProp).map((type) => ({
  prop: 'type',
  case: type,
  value: type,
}))
export const propDisabledCases: TPropTestCase<IAltCoreInputFieldProps, 'disabled'>[] = [
  { prop: 'disabled', case: 'true', value: true },
  { prop: 'disabled', case: 'false', value: false },
]
export const propReadonlyCases: TPropTestCase<IAltCoreInputFieldProps, 'readonly'>[] = [
  { prop: 'readonly', case: 'true', value: true },
  { prop: 'readonly', case: 'false', value: false },
]
export const propRequiredCases: TPropTestCase<IAltCoreInputFieldProps, 'required'>[] = [
  { prop: 'required', case: 'true', value: true },
  { prop: 'required', case: 'false', value: false },
]
export const propMaxlengthCases: TPropTestCase<IAltCoreInputFieldProps, 'maxlength'>[] = [
  { prop: 'maxlength', case: '10', value: 10 },
  { prop: 'maxlength', case: '0', value: 0 },
]
export const propMaskOptionsCases: TPropTestCase<IAltCoreInputFieldProps, 'maskOptions'>[] = [
  { prop: 'maskOptions', case: 'with a mask', value: testMaskOptions },
  { prop: 'maskOptions', case: 'without a mask', value: undefined },
]
export const propErrorsCases: TPropTestCase<IAltCoreInputFieldProps, 'errors'>[] = [
  { prop: 'errors', case: 'with errors', value: testErrors },
  { prop: 'errors', case: 'with one error', value: [testErrors[0]] },
  { prop: 'errors', case: 'without errors', value: [] },
]
export const propClearableCases: TPropTestCase<IAltCoreInputFieldProps, 'clearable'>[] = [
  { prop: 'clearable', case: 'clearable', value: true },
  { prop: 'clearable', case: 'not clearable', value: false },
]
export const propSizeCases: TPropTestCase<IAltCoreInputFieldProps, 'size'>[] = sizes.map((size) => ({
  prop: 'size',
  case: size,
  value: size,
}))

type TPropLabel<K extends keyof IAltCoreInputFieldProps, T extends keyof IAltCoreLabelExternalProps> = TPropTestCase<IAltCoreInputFieldProps, K> & { labelProp: T }
type TPropAnnotation<K extends keyof IAltCoreInputFieldProps, T extends keyof IAltCoreAnnotationExternalProps> = TPropTestCase<IAltCoreInputFieldProps, K> & { annotationProp: T }

export const propLabelOverflowDebounceCases: (TPropLabel<'labelOverflowDebounce', 'debounce'>)[] = [
  { prop: 'labelOverflowDebounce', labelProp: 'debounce', case: '100', value: 100 },
  { prop: 'labelOverflowDebounce', labelProp: 'debounce', case: '0', value: 0 },
]
export const propLabelTextCases: TPropLabel<'labelText', 'text'>[] = [
  { prop: 'labelText', labelProp: 'text', case: 'with text', value: text },
  { prop: 'labelText', labelProp: 'text', case: 'without text', value: '' },
]
export const propLabelTooltipTextCases: TPropLabel<'labelTooltipText', 'tooltipText'>[] = [
  { prop: 'labelTooltipText', labelProp: 'tooltipText', case: 'with text', value: text },
  { prop: 'labelTooltipText', labelProp: 'tooltipText', case: 'without text', value: '' },
]
export const propAnnotationTextCases: TPropAnnotation<'annotationText', 'text'>[] = [
  { prop: 'annotationText', annotationProp: 'text', case: 'with text', value: text },
  { prop: 'annotationText', annotationProp: 'text', case: 'without text', value: '' },
]
